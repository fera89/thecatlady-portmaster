# gptokeyb2 mapping for The Cat Lady on R36S.
# The game is keyboard-only (verified): Left/Right = move, Up = interact,
# Down = inventory, Enter = confirm/select, Esc = save/load menu,
# Space = skip dialogue. So we map the pad straight to those keys (no mouse).

# --- D-pad = arrow keys -----------------------------------------------------
up = up
down = down
left = left
right = right

# --- left analog stick mirrors the D-pad ------------------------------------
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
deadzone = 6000

# --- face buttons -----------------------------------------------------------
a = enter        # confirm / select dialogue option
b = esc       # back / open save-load menu
x = space        # skip dialogue
y = up           # interact (same as D-pad Up)

# --- system buttons ---------------------------------------------------------
start = esc   # save / load menu
back = esc    # Select -> menu (also the quit hotkey modifier)

# --- shoulders (handy duplicates) ------------------------------------------
l1 = down        # inventory
r1 = up          # interact

# NOTE: do NOT define a hotkey/kill combo here. gptokeyb2 is launched with
# "-sudokill" (from control.txt on ArkOS), which handles quit (Select+Start)
# natively. Defining back_start=kill here reserved Start and stopped it from
# sending its own key.
